<Window x:Class="RecycleBinStudio.Views.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновления" Icon="../Assets/AppIcon.ico" Width="510" Height="340" MinWidth="430" MinHeight="285"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#10161B" Foreground="#F1F5F3" FontFamily="Segoe UI" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Обновления" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionLabel" Foreground="#A6B5BA" Margin="0,4,0,15"/>
            <CheckBox x:Name="Automatic" Content="Автоматически обновлять при запуске" Foreground="#F1F5F3"/>
            <TextBlock x:Name="Details" Foreground="#A6B5BA" Margin="0,5,0,14" TextWrapping="Wrap"/>
            <WrapPanel>
                <Button x:Name="CheckButton" Content="Проверить сейчас" Click="Check" Margin="0,0,8,6"/>
                <Button x:Name="InstallButton" Content="Скачать и установить" Click="Install"
                        Background="#8EE0BD" BorderBrush="#8EE0BD" Foreground="#11241D"
                        Visibility="Collapsed" Margin="0,0,8,6"/>
                <Button Content="Релизы GitHub ↗" Click="OpenReleases" Margin="0,0,0,6"/>
            </WrapPanel>
            <TextBlock x:Name="Status" Foreground="#A6B5BA" TextWrapping="Wrap" Margin="0,5,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </ScrollViewer>
</Window>
