<Window x:Class="RecycleBinStudio.Views.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновления" Icon="../Assets/AppIcon.ico" Style="{StaticResource StudioWindow}"
        Width="520" Height="362" MinWidth="454" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="Обновления" Style="{StaticResource Heading}"/>
            <Border Style="{StaticResource Panel}" Margin="0,14,0,12">
                <StackPanel>
                    <TextBlock x:Name="VersionLabel" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Status" Style="{StaticResource MutedText}" Margin="0,5,0,0"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <CheckBox x:Name="Automatic" Content="Устанавливать обновления при запуске"/>
            <TextBlock x:Name="Details" Style="{StaticResource MutedText}" Margin="0,4,0,12"/>
            <DockPanel LastChildFill="False">
                <Grid DockPanel.Dock="Right">
                    <Button x:Name="CheckButton" Content="Проверить" Click="Check" MinWidth="174"
                            Style="{StaticResource PrimaryAction}"/>
                    <Button x:Name="InstallButton" Content="Скачать и установить" Click="Install" MinWidth="174"
                            Style="{StaticResource PrimaryAction}" Visibility="Collapsed"/>
                </Grid>
                <Button Content="Релизы GitHub ↗" Click="OpenReleases" Style="{StaticResource QuietAction}"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
