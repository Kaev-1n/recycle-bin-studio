<Window x:Class="RecycleBinStudio.Views.PresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пресеты корзины" Icon="../Assets/AppIcon.ico" Width="710" Height="610"
        MinWidth="570" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#10161B" Foreground="#F1F5F3" FontFamily="Segoe UI" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Form" Margin="24">
            <TextBlock Text="Создать пресет из фото" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Вставьте промпт в генератор, прикрепите фото и сохраните результат."
                       Foreground="#A6B5BA" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <ComboBox x:Name="PromptTemplates" DisplayMemberPath="Name"
                      AutomationProperties.Name="Стиль промпта"/>
            <TextBlock Text="{Binding SelectedItem.Description, ElementName=PromptTemplates}"
                       Foreground="#A6B5BA" TextWrapping="Wrap" Margin="0,5,0,10"/>
            <WrapPanel>
                <Button Content="Копировать промпт" Click="CopyPrompt" Margin="0,0,8,0"/>
                <Button Content="Открыть ChatGPT ↗" Click="OpenGenerator"/>
            </WrapPanel>
            <Border Background="#1A242B" BorderBrush="#34454D" BorderThickness="1" CornerRadius="10"
                    Padding="14" Margin="0,15,0,12" AllowDrop="True" DragOver="ImagesDragOver" Drop="ImagesDropped">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="Общая картинка…" Click="ChoosePair" Margin="0,0,8,6"/>
                        <Button Content="Файл для пустой…" Tag="empty" Click="ChooseSingle" Margin="0,0,8,6"/>
                        <Button Content="Файл для полной…" Tag="full" Click="ChooseSingle" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="Перетащите сюда общую картинку или два файла PNG, JPG, ICO."
                               Foreground="#A6B5BA" TextWrapping="Wrap" Margin="0,1,0,10"/>
                    <StackPanel x:Name="SplitControls" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Text="Граница между иконками" Foreground="#A6B5BA"/>
                        <Slider x:Name="SplitPosition" Minimum="0.1" Maximum="0.9" Value="0.5"
                                SmallChange="0.01" LargeChange="0.05" ValueChanged="SplitChanged"
                                AutomationProperties.Name="Граница между иконками"/>
                    </StackPanel>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,7,0">
                            <TextBlock Text="Пустая" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#131C22" CornerRadius="8" Height="86">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image x:Name="EmptyLarge" Width="64" Height="64" Margin="0,0,16,0"/>
                                    <Image x:Name="EmptySmall" Width="32" Height="32"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="7,0,0,0">
                            <TextBlock Text="Полная" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#131C22" CornerRadius="8" Height="86">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image x:Name="FullLarge" Width="64" Height="64" Margin="0,0,16,0"/>
                                    <Image x:Name="FullSmall" Width="32" Height="32"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </UniformGrid>
                    <Button x:Name="SwapButton" Content="Поменять местами" Click="Swap" IsEnabled="False"
                            HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Название пресета" Foreground="#A6B5BA"/>
            <DockPanel Margin="0,5,0,0">
                <Button x:Name="ApplyPresetButton" DockPanel.Dock="Right" Content="Сохранить и применить"
                        Background="#8EE0BD" BorderBrush="#8EE0BD" Foreground="#11241D"
                        Click="Apply" IsEnabled="False" Margin="10,0,0,0"/>
                <TextBox x:Name="PresetName" MaxLength="80" Padding="8,5" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Название пресета" TextChanged="NameChanged"/>
            </DockPanel>
            <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#A6B5BA" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
            <StackPanel x:Name="SavedSection" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Text="Мои пресеты" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Загрузить" Click="LoadSaved" Margin="10,0,0,0"/>
                    <ComboBox x:Name="SavedPresets" DisplayMemberPath="Name" AutomationProperties.Name="Мои пресеты"/>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
