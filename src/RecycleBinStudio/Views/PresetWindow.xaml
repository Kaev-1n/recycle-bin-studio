<Window x:Class="RecycleBinStudio.Views.PresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать тему из фото" Icon="../Assets/AppIcon.ico" Style="{StaticResource StudioWindow}"
        Width="690" Height="640" MinWidth="576" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Создать тему из фото" Style="{StaticResource Heading}"/>
            <TextBlock Text="Соберите пару значков для пустой и полной корзины."
                       Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Feedback" Style="{StaticResource MutedText}" MinHeight="21"
                       AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
            <Grid x:Name="SaveControls" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <Label Content="Название темы" Target="{Binding ElementName=PresetName}" Padding="0,0,0,4"/>
                    <TextBox x:Name="PresetName" MaxLength="80" Padding="8,6" TextChanged="NameChanged"/>
                </StackPanel>
                <Button x:Name="SavePresetButton" Grid.Column="1" Content="Сохранить и посмотреть"
                        Style="{StaticResource PrimaryAction}" Click="Save" IsEnabled="False" VerticalAlignment="Bottom"/>
            </Grid>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Form" Margin="0,0,6,0">
                <Border x:Name="ImportPanel" Style="{StaticResource Panel}" AllowDrop="True"
                        DragOver="ImagesDragOver" DragLeave="ImagesDragLeave" Drop="ImagesDropped">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <Button Content="Загрузить общую картинку…" Click="ChoosePair"/>
                            <Button x:Name="SwapButton" DockPanel.Dock="Right" Content="Поменять местами" Click="Swap"
                                    Style="{StaticResource QuietAction}" Visibility="Hidden"/>
                        </DockPanel>
                        <TextBlock Text="Можно перетащить одну картинку с парой или выбрать файлы по отдельности."
                                   Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="SplitControls" Visibility="Collapsed" Width="204" Margin="0,0,14,0">
                                <Grid x:Name="SourcePreview" HorizontalAlignment="Center" SizeChanged="UpdateDivider">
                                    <Image x:Name="SourceImage" MaxWidth="204" MaxHeight="126" Stretch="Uniform"/>
                                    <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                        <Border x:Name="Divider" Width="2" Height="{Binding ActualHeight, ElementName=SourcePreview}"
                                                Background="{StaticResource Mint}" BorderBrush="{StaticResource OnMint}"
                                                BorderThickness="0,0,1,0"/>
                                    </Canvas>
                                </Grid>
                                <Label Content="Граница между значками" Target="{Binding ElementName=SplitPosition}"
                                       Padding="0,5,0,0"/>
                                <Slider x:Name="SplitPosition" Minimum="0.1" Maximum="0.9" Value="0.5"
                                        SmallChange="0.01" LargeChange="0.05" IsMoveToPointEnabled="True"
                                        ValueChanged="SplitChanged"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Пустая" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource PreviewSurface}" CornerRadius="6" Height="75">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image x:Name="EmptyLarge" Width="56" Height="56" Margin="0,0,14,0"/>
                                            <Image x:Name="EmptySmall" Width="32" Height="32"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Выбрать файл…" Tag="empty" Click="ChooseSingle" Margin="0,8,0,0"
                                            AutomationProperties.Name="Выбрать файл для пустой корзины"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Полная" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource PreviewSurface}" CornerRadius="6" Height="75">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image x:Name="FullLarge" Width="56" Height="56" Margin="0,0,14,0"/>
                                            <Image x:Name="FullSmall" Width="32" Height="32"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Выбрать файл…" Tag="full" Click="ChooseSingle" Margin="0,8,0,0"
                                            AutomationProperties.Name="Выбрать файл для полной корзины"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
                <Expander Header="Подготовить картинку в ChatGPT" Margin="0,12,0,0">
                    <StackPanel Margin="8,10,8,10">
                        <ComboBox x:Name="PromptTemplates" DisplayMemberPath="Name" AutomationProperties.Name="Стиль темы"
                                  HorizontalAlignment="Left" MinWidth="172"/>
                        <TextBlock Text="{Binding SelectedItem.Description, ElementName=PromptTemplates}"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,4"/>
                        <TextBlock Text="Скопируйте промпт, вставьте его в ChatGPT и прикрепите фото. Затем загрузите сюда результат."
                                   Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="Копировать промпт" Click="CopyPrompt" Margin="0,0,8,0"/>
                            <Button Content="Открыть ChatGPT ↗" Click="OpenGenerator" Style="{StaticResource QuietAction}"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
