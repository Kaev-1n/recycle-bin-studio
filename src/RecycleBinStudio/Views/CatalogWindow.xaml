<Window x:Class="RecycleBinStudio.Views.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Темы корзины" Icon="../Assets/AppIcon.ico" Style="{StaticResource StudioWindow}"
        Width="678" Height="584" MinWidth="540" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="ThemeList" TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel}" Margin="0,0,8,8" ToolTip="{Binding Description}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                                <Border Background="{StaticResource PreviewSurface}" CornerRadius="6" Padding="8">
                                    <UniformGrid Columns="2">
                                        <StackPanel>
                                            <Image Source="{Binding Pair.Empty.Preview}" Width="48" Height="48"/>
                                            <TextBlock Text="Пустая" FontSize="11" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <Image Source="{Binding Pair.Full.Preview}" Width="48" Height="48"/>
                                            <TextBlock Text="Полная" FontSize="11" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>
                                <Grid Margin="0,10,0,0" MinHeight="36">
                                    <TextBlock Text="{Binding Status}" ToolTip="{Binding Error}" VerticalAlignment="Center"
                                               Style="{StaticResource MutedText}"/>
                                    <Button Content="Выбрать" Click="SelectPreset"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Выбрать тему · {0}'}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Action}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Темы корзины" Style="{StaticResource Heading}"/>
            <TextBlock Text="Выберите пару для предпросмотра." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        </StackPanel>
        <TabControl x:Name="ThemeTabs" Background="{StaticResource Canvas}" BorderThickness="0"
                    SelectionChanged="ThemeTabChanged">
            <TabItem Header="Готовые">
                <DockPanel Margin="0,12,0,0">
                    <Button x:Name="RetryButton" DockPanel.Dock="Bottom" Content="Повторить загрузку" Click="Retry"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Presets" Style="{StaticResource ThemeList}"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="SavedTab" Header="Мои">
                <DockPanel Margin="0,12,0,0">
                    <TextBlock x:Name="SavedStatus" DockPanel.Dock="Top" Style="{StaticResource MutedText}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SavedThemes" Style="{StaticResource ThemeList}"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
