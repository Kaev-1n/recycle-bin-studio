<Window x:Class="RecycleBinStudio.Views.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог пресетов" Icon="../Assets/AppIcon.ico" Width="680" Height="520"
        MinWidth="510" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#10161B" Foreground="#F1F5F3" FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="Повторить загрузку"
                    Click="Retry" Visibility="Collapsed"/>
            <TextBlock Text="Каталог пресетов" FontWeight="SemiBold" FontSize="26"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Presets">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A242B" BorderBrush="#34454D" BorderThickness="1"
                                CornerRadius="12" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#A6B5BA" TextWrapping="Wrap" Margin="0,3,0,9"/>
                                    <Button Content="Применить" Click="SelectPreset" HorizontalAlignment="Left"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Применить · {0}'}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding Status}" ToolTip="{Binding Error}" Foreground="#A6B5BA">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,12,0">
                                        <Image Source="{Binding Pair.Empty.Preview}" Width="62" Height="62" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Пустая" Foreground="#A6B5BA" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <Image Source="{Binding Pair.Full.Preview}" Width="62" Height="62" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Полная" Foreground="#A6B5BA" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
