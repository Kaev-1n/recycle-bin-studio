<Window x:Class="RecycleBinStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recycle Bin Studio" Icon="Assets/AppIcon.ico"
        Width="790" Height="615" MinWidth="600" MinHeight="410"
        WindowStartupLocation="CenterScreen" Background="#10161B" Foreground="#F1F5F3"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Secondary" Color="#A6B5BA"/>
        <SolidColorBrush x:Key="Accent" Color="#8EE0BD"/>
        <DataTemplate x:Key="CardTemplate">
            <Border Background="#1A242B" BorderBrush="#34454D" BorderThickness="1" CornerRadius="14" Padding="18"
                    AllowDrop="True" DragOver="CardDragOver" Drop="CardDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"/>
                        <Border DockPanel.Dock="Right" Background="#263F38" Padding="8,3" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Активна" FontSize="12" Foreground="{StaticResource Accent}"/>
                        </Border>
                    </DockPanel>
                    <Border Grid.Row="1" Height="142" Margin="0,13,0,10" CornerRadius="9" Background="#131C22">
                        <Image Source="{Binding Preview}" Width="96" Height="96" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding Caption}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Caption}" Foreground="{StaticResource Secondary}" Margin="0,0,0,12"/>
                    <WrapPanel Grid.Row="3">
                        <Button Click="ChooseIcon" Content="Выбрать файл…" AutomationProperties.Name="{Binding Title, StringFormat='Выбрать иконку · {0}'}"/>
                        <Button Click="DiscardIcon" IsEnabled="{Binding HasDraft}" Content="Отменить" Margin="8,0,0,0"
                                AutomationProperties.Name="{Binding Title, StringFormat='Отменить замену · {0}'}"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,24">
            <TextBlock Text="Recycle Bin Studio" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock x:Name="BinStatus" Text="Читаем состояние корзины…" Foreground="{StaticResource Accent}" Margin="0,5,0,18"/>
            <Grid x:Name="Cards">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="EmptyCard" ContentTemplate="{StaticResource CardTemplate}"/>
                <ContentControl x:Name="FullCard" Grid.Column="2" ContentTemplate="{StaticResource CardTemplate}"/>
            </Grid>
            <TextBlock Text="Перетащите ICO, PNG или JPG на нужную карточку." Foreground="{StaticResource Secondary}" Margin="0,11,0,17"/>
            <DockPanel x:Name="Actions" LastChildFill="False">
                <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Применить" Click="ApplyIcons"
                        Background="#8EE0BD" BorderBrush="#8EE0BD" Foreground="#11241D" IsEnabled="False"/>
                <Button Content="Каталог пресетов" Click="OpenCatalog" Margin="0,0,8,0"/>
                <Button Content="AI-пресеты" Click="OpenPresetStudio" Margin="0,0,8,0"/>
                <Button Content="Значки Windows" Click="RestoreDefaults"/>
            </DockPanel>
            <DockPanel Margin="0,10,0,0">
                <Button Content="Обновления" Click="OpenUpdates" DockPanel.Dock="Right"
                        Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="Feedback" TextWrapping="Wrap" MinHeight="20" VerticalAlignment="Center"
                           Foreground="{StaticResource Secondary}" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
