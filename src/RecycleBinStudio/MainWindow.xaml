<Window x:Class="RecycleBinStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recycle Bin Studio" Icon="Assets/AppIcon.ico" Style="{StaticResource StudioWindow}"
        Width="752" Height="544" MinWidth="596" MinHeight="440" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="DropTarget" Style="{StaticResource Panel}" AllowDrop="True"
                    DragOver="CardDragOver" DragLeave="CardDragLeave" Drop="CardDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="ActiveLabel" DockPanel.Dock="Right" Text="Состояние сейчас"
                                   Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Visibility="Collapsed"/>
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{StaticResource PreviewSurface}" CornerRadius="6" Margin="0,12"
                            MinHeight="120">
                        <Image Source="{Binding Preview, NotifyOnTargetUpdated=True}" TargetUpdated="PreviewUpdated"
                               Width="96" Height="96"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding Caption}" Foreground="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}" Margin="0,0,0,8"/>
                        <DockPanel LastChildFill="False">
                            <Button Content="Заменить…" Click="ChooseIcon"
                                    AutomationProperties.Name="{Binding Title, StringFormat='Заменить значок · {0}'}"/>
                            <Button x:Name="DiscardButton" Content="Отменить" Click="DiscardIcon"
                                    Style="{StaticResource QuietAction}" Visibility="Hidden" Margin="4,0,0,0"
                                    AutomationProperties.Name="{Binding Title, StringFormat='Отменить замену · {0}'}"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter TargetName="ActiveLabel" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDraft}" Value="True">
                    <Setter TargetName="DiscardButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Значки корзины" Style="{StaticResource Heading}"/>
                <TextBlock x:Name="BinStatus" Text="Читаем состояние корзины…" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button x:Name="MoreButton" Grid.Column="1" Content="⋯" FontSize="20" MinWidth="40"
                    Style="{StaticResource QuietAction}" Click="OpenMenu" VerticalAlignment="Top"
                    AutomationProperties.Name="Действия с приложением" ToolTip="Другие действия">
                <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem Header="Вернуть стандартные значки…" Click="RestoreDefaults"/>
                        <Separator/>
                        <MenuItem Header="Обновления…" Click="OpenUpdates"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Feedback" Style="{StaticResource MutedText}" MinHeight="21"
                       Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
            <DockPanel x:Name="Actions" LastChildFill="False">
                <Grid DockPanel.Dock="Right">
                    <Button x:Name="ChooseThemeButton" Content="Выбрать тему" Click="OpenCatalog"
                            MinWidth="177" Style="{StaticResource PrimaryAction}"/>
                    <Button x:Name="ApplyButton" Content="Применить к корзине" Click="ApplyIcons"
                            MinWidth="177" Style="{StaticResource PrimaryAction}" Visibility="Collapsed"/>
                </Grid>
                <Button x:Name="BrowseThemesButton" Content="Темы…" Click="OpenCatalog"
                        Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button Content="Создать из фото…" Click="OpenPresetStudio"/>
            </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="Cards">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="EmptyCard" ContentTemplate="{StaticResource CardTemplate}"/>
                <ContentControl x:Name="FullCard" Grid.Column="2" ContentTemplate="{StaticResource CardTemplate}"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
